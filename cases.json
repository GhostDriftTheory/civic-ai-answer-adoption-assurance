{
  "schema": "civic-poc-cases/1.0",
  "metadata": {
    "description": "第一弾PoC／制度・補助金案内。制度・資料・自治体・相談者は全て架空。",
    "as_of_note": "基準日は2026-10-01で固定。実時計の今日を意味しない。",
    "original_html_sha256": "3a52e33171a16e9c44ffff001176838e5a1a43c2a03844990b3c07b4cc60ff7a",
    "public_release_note": "外部公表の可否、知財、公表文、社名使用は別途確認。実住民データ・外部通信・実AI接続なし。"
  },
  "requirements": {
    "id": "BRP-DEMO-01",
    "version": "1.0",
    "schema": "civic-answer-adoption-demo/1.0",
    "target": {
      "municipality": "自治体X",
      "program_id": "DEMO-DX-2026"
    },
    "allowed_data": "public_sample_and_synthetic",
    "permitted_use": "staff_answer_draft",
    "source_catalog": "SYNTHETIC-CATALOG-2026-10",
    "decision_order": [
      "REJECT",
      "HOLD",
      "PASS"
    ],
    "criteria": [
      {
        "id": "R01",
        "name": "対象自治体・制度の一致",
        "description": "回答・参照資料が、依頼された自治体と制度を指しているか。"
      },
      {
        "id": "R02",
        "name": "資料の版・募集期間",
        "description": "採用対象の版と固定基準日に照らして、資料・案内期間が有効か。"
      },
      {
        "id": "R03",
        "name": "相談条件と案内の対応",
        "description": "事業所、従業員数、滞納、重複利用の既知・未知を区別する。"
      },
      {
        "id": "R04",
        "name": "回答中の主張と根拠",
        "description": "自治体・金額・補助率・期限・対象候補の主張を、資料中の項目に対応付ける。"
      },
      {
        "id": "R05",
        "name": "必須条件・断定の抑制",
        "description": "必須の注意条件を記載し、採択・受給を確定したように表現しない。"
      },
      {
        "id": "R06",
        "name": "データ区分・処理設定",
        "description": "同梱の架空サンプルと合成データだけを使う構成か。実データ判定は対象外。"
      },
      {
        "id": "R07",
        "name": "利用範囲・人間による確定",
        "description": "職員の回答案確認に限定し、対外自動送信や自動決定を許可しない。"
      },
      {
        "id": "R08",
        "name": "主張・資料・記録の同一性",
        "description": "同梱資料の内容、主張が参照する内容識別値、表示文と構造化主張を照合する。"
      }
    ],
    "mandatory_conditions": [
      "establishment",
      "employees",
      "tax",
      "duplicate",
      "human_decision"
    ],
    "gate_semantics": "All criteria PASS -> staff draft only. Any REJECT overrides HOLD. No administrative decision or external transmission.",
    "exclusions": [
      "legal_compliance",
      "source_authenticity",
      "real_applicant_facts",
      "general_natural_language_correctness",
      "formal_proof_checking",
      "production_privacy_assurance"
    ]
  },
  "source_catalog": [
    {
      "id": "SRC-01",
      "title": "自治体X 小規模事業者デジタル活用支援補助金 募集要領（架空）",
      "version": "1.2",
      "year": 2026,
      "municipality": "自治体X",
      "program_id": "DEMO-DX-2026",
      "published_at": "2026-09-01",
      "valid_from": "2026-09-01",
      "valid_to": "2026-10-31",
      "classification": "public_sample",
      "facts": {
        "municipality": "自治体X",
        "program_id": "DEMO-DX-2026",
        "employee_limit": 20,
        "max_yen": 300000,
        "rate": 0.5,
        "deadline": "2026-10-31",
        "establishment_required": true,
        "tax_arrears_allowed": false,
        "duplicate_allowed": false
      },
      "sections": {
        "scope": "§1 対象地域・制度",
        "eligibility": "§2 対象事業者",
        "amount": "§3 補助率・上限",
        "period": "§4 受付期間"
      },
      "text": "【架空のデモ資料】\n§1 自治体Xに事業所を有する小規模事業者のデジタル活用を支援する。\n§2 常用従業員20人以下、市税の滞納がないこと、同じ経費で他制度の補助を受けていないこと。\n§3 補助率は対象経費の1/2、上限30万円。\n§4 申請受付は2026年9月1日から2026年10月31日まで。"
    },
    {
      "id": "SRC-02",
      "title": "申請・案内時の確認事項（架空）",
      "version": "1.0",
      "year": 2026,
      "municipality": "自治体X",
      "program_id": "DEMO-DX-2026",
      "published_at": "2026-09-01",
      "valid_from": "2026-09-01",
      "valid_to": "2026-10-31",
      "classification": "public_sample",
      "facts": {
        "mandatory_conditions": [
          "establishment",
          "employees",
          "tax",
          "duplicate",
          "human_decision"
        ],
        "award_guarantee": false,
        "final_decision": "human_administrative_review"
      },
      "sections": {
        "conditions": "§1 案内に含める確認条件",
        "review": "§2 審査・決定"
      },
      "text": "【架空のデモ資料】\n§1 案内には、市内事業所・従業員数・市税滞納・同一経費への重複補助を確認条件として明記する。\n§2 申請可能性の案内は交付・採択の決定ではない。正式な申請・審査を経て自治体が判断する。回答案の対外使用には職員の確認が必要。"
    }
  ],
